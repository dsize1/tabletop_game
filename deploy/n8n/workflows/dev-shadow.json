{
  "name": "dev-shadow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "dev-shadow",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-dev-shadow",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -200,
        0
      ],
      "webhookId": "dev-shadow"
    },
    {
      "parameters": {
        "jsCode": "// HMAC 校验：signature = HMAC-SHA256(secret, session_id + \".\" + timestamp)\n// 重放防护：timestamp 与服务器时间差 ≤ 300s。\nconst crypto = require('crypto');\nconst body = $json.body ?? {};\nconst headers = $json.headers || {};\nconst secret = $env.DEV_WEBHOOK_SECRET || '';\nconst sid = String(body.session_id || '');\nconst sig = String(headers['x-dev-signature'] || '').trim();\nconst ts = String(headers['x-dev-timestamp'] || '').trim();\nif (!secret) return [{ json: { ok: false, reason: 'secret_missing' } }];\nif (!sig || !ts) return [{ json: { ok: false, reason: 'signature_missing' } }];\nif (!/^\\d+$/.test(ts)) return [{ json: { ok: false, reason: 'timestamp_invalid' } }];\nconst skew = Math.abs(Math.floor(Date.now() / 1000) - Number(ts));\nif (skew > 300) return [{ json: { ok: false, reason: 'timestamp_out_of_window' } }];\nif (!sid) return [{ json: { ok: false, reason: 'missing_session_id' } }];\nconst expected = crypto.createHmac('sha256', secret).update(sid + '.' + ts).digest('hex');\nconst a = Buffer.from(sig);\nconst b = Buffer.from(expected);\nif (a.length !== b.length || !crypto.timingSafeEqual(a, b)) {\n  return [{ json: { ok: false, reason: 'signature_invalid' } }];\n}\nreturn [{ json: { ok: true, session_id: sid, qq_id: body.qq_id || '' } }];"
      },
      "id": "verify-hmac",
      "name": "Verify HMAC",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "ok-true",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-signature-ok",
      "name": "IF 签名通过",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        200,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.DEV_SERVER_URL }}/internal/dev_task/{{ $('Verify HMAC').item.json.session_id }}",
        "options": {
          "timeout": 5000
        }
      },
      "id": "get-payload",
      "name": "GET payload",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        -100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DEV_SERVER_URL }}/internal/dev/permission",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ op: 'read', qq_id: $('Verify HMAC').item.json.qq_id || '', session_id: $('Verify HMAC').item.json.session_id }) }}",
        "options": {
          "timeout": 5000
        }
      },
      "id": "check-permission",
      "name": "POST permission",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        100
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "respond-ok",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1080,
        -100
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ shadow: true, reason: $json.reason || 'not_verifying' }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "respond-skip",
      "name": "Respond skip",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        880,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "// shadow 决策：只读判定，不推进状态、不通知\nconst status = $('GET payload').item.json.task?.status ?? 'unknown';\nconst perm = $json || {};\nreturn [{ json: { shadow: true, status, permission: perm, would_run_ci: status === 'verifying' && perm.allow === true } }];"
      },
      "id": "shadow-decision",
      "name": "Decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        860,
        -100
      ]
    }
  ],
  "connections": {
