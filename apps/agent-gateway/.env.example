# DeepSeek LLM（OpenAI 兼容）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_MS=30000
LLM_MAX_TOKENS=2000
# 思考模式（1=开启，默认；0=关闭，快/省 token）。被动回复窗口 5 分钟，见 docs/conventions/external-constraints.md
LLM_THINKING_ENABLED=1

# SystemOne 决策服务（本地 StartLux-Decision，/v1/systemone）
# 部署见 docs/modules/decision-service.md
SYSTEMONE_URL=http://127.0.0.1:8090
SYSTEMONE_TIMEOUT_MS=3000
# 意图置信度双阈值：≥ 高阈值直接路由；[低, 高) 走人工「意图确认」（回 y/n）；< 低阈值 → #前缀 → 默认 chat
# 取值范围依据：205 条历史回放标定（非 chat 正确预测 0.840~0.965、错判 0.388~0.815；[0.6,0.8) 非 chat 预测 9/9 错）
DECISION_INTENT_THRESHOLD=0.6
DECISION_INTENT_THRESHOLD_HIGH=0.8
# 未决「意图确认」在 Redis 的存活时长（秒），默认对齐群被动回复窗口 5 分钟
INTENT_CONFIRM_TTL_SEC=300

# 时间上下文与话题切换（时间只进 LLM 上下文，不落 chat:history、不出站消息）
# 时区单点：容器默认 UTC，故显式固定
CHAT_TZ=Asia/Shanghai
# 距上次对话 ≥ 该间隔（分钟）才做「是否新话题」判定，并丢弃已失去语境的未决意图确认；=0 关闭门控
# 经验值（非外部约束）：把「午休」与「过夜」归为同一类边界
TOPIC_GAP_MINUTES=30
# topic_switch 的 P(true) 阈值（≥ 判新话题）。经验值（非外部约束），保守取值
TOPIC_SWITCH_THRESHOLD=0.7
# 聊天历史热缓存条数上限
CHAT_HISTORY_LIMIT=20

# Redis
REDIS_URL=redis://127.0.0.1:6379

# 开发白名单（member_openid 逗号分隔）
DEV_WHITELIST=

# 游戏路径 LLM 情景叙述开关（1=开启，在模板摘要后追加一条 msg_seq=2 叙述；默认关）
GAME_NARRATION_ENABLED=

# 聊天链接抓取（Plan B）：消息含 https:// 时先用 SystemOne（noul 是/否）判断是否抓取该链接
CHAT_LINK_FETCH_ENABLED=1
CHAT_LINK_FETCH_THRESHOLD=0.5
CHAT_LINK_TIMEOUT_MS=10000
CHAT_LINK_MAX_CHARS=2000

# server 内部 HTTP（auth 签发 token）
SERVER_URL=http://127.0.0.1:3000

# web 公网基址（cloudflared 域名，用于拼接计划文档短链；留空则退回长文推送）
PUBLIC_BASE_URL=

# ===== 全局人物画像（跨群，ADR-0007）=====
# 画像内存缓存 TTL（ms）；日批写回后缓存整体失效
PROFILE_CACHE_TTL_MS=600000

# 画像日批蒸馏（默认关闭）：1=开启（每日 PROFILE_DISTILL_HOUR:00 CHAT_TZ 触发）
PROFILE_DISTILL_ENABLED=0
PROFILE_DISTILL_HOUR=4
# 蒸馏模型（本地、按需起停）：用**非思考型小模型**（思考型会“想不停”/复读）
# Qwen2.5-3B-Instruct Q4_K_M（~2.1GB，中文强、指令遵循好）
PROFILE_LLM_MODEL=C:/llm/models/qwen2.5-3b-instruct-q4_k_m.gguf
PROFILE_LLM_BIN=llama-server
PROFILE_LLM_PORT=8082
PROFILE_LLM_NGL=99
PROFILE_LLM_CTX=8192
# 生成温度（经验值）；分块越小越聚焦
PROFILE_LLM_TEMPERATURE=0.2
# 禁用思考（仅对支持 enable_thinking 的模型生效）；Qwen2.5 无思考，任意值均可
PROFILE_LLM_DISABLE_THINKING=0
# 单次生成 token 上限（思考 + 正文）
PROFILE_LLM_MAX_TOKENS=4096
# 分块字符上限（长历史分块 map-reduce；小模型建议 2000 左右）/ 低于该用户发言条数不蒸馏
PROFILE_CHUNK_CHARS=2000
PROFILE_MIN_USER_MESSAGES=3
# SystemOne 把关阈值：P(值得写入画像) ≥ 阈值才保留（经验值，可配）
PROFILE_GATE_THRESHOLD=0.5
# 画像文本上限（字符）
PROFILE_MAX_CHARS=1200
# chat.log 归档条数上限
CHAT_LOG_MAXLEN=1000
