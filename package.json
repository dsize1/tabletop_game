{
  "name": "tabletop-game",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "仓库根脚本入口（真正的 npm workspaces 根在 apps/）。仅做命令转发，勿在此安装依赖。",
  "scripts": {
    "dev:up": "node apps/scripts/dev-up.mjs",
    "dev:up:qq": "node apps/scripts/dev-up.mjs",
    "dev:up:noqq": "node apps/scripts/dev-up.mjs --no-qq",
    "dev:down": "node apps/scripts/dev-down.mjs",
    "status": "node apps/scripts/status.mjs",
    "check:decision": "node apps/scripts/check-decision-service.mjs",
    "check:proactive-gate": "node apps/scripts/check-proactive-gate.mjs",
    "verify:push": "node apps/verify-push.mjs",
    "test:agent-gateway": "npm --prefix apps run test:agent-gateway",
    "test:qq-gateway": "npm --prefix apps run test:qq-gateway",
    "test:web": "npm --prefix apps run test:web",
    "assets:board": "node apps/scripts/board-assets.mjs",
    "deploy:local": "node apps/scripts/deploy-local.mjs",
    "dev:props": "npm --prefix apps run dev:props",
    "build:props": "npm --prefix apps run build:props",
    "test:props": "npm --prefix apps run test:props",
    "check:props-boundary": "node apps/scripts/check-props-admin-boundary.mjs",
    "gen:sgs-engine-data": "node apps/scripts/gen-sanguosha-engine-data.mjs",
    "check:sgs-engine-data": "node apps/scripts/gen-sanguosha-engine-data.mjs --check",
    "check:sgs-skill-cases": "node apps/scripts/check-sgs-skill-cases.mjs",
    "check:sgs-skill-docs": "node apps/scripts/check-sgs-skill-docs.mjs",
    "check:sgs-pack-pool": "cargo test --manifest-path crates/Cargo.toml -p sanguosha pack_pool",
    "check:sgs-view-contract": "cargo test --manifest-path crates/Cargo.toml -p sanguosha view_contract",
    "check:interaction-primitives": "cargo test --manifest-path crates/Cargo.toml -p sanguosha interaction_",
    "sgs:batch-status": "node apps/scripts/sgs-batch-status.mjs",
    "sgs:batch-scaffold": "node apps/scripts/sgs-batch-scaffold.mjs",
    "sgs:check": "node apps/scripts/check-sgs-all.mjs",
    "sgs:check:fast": "node apps/scripts/check-sgs-all.mjs --fast",
    "sgs:check:full": "node apps/scripts/check-sgs-all.mjs --full",
    "verify:sanguosha": "node apps/verify-sanguosha.mjs",
    "sgs:web-room": "node apps/scripts/sgs-web-room.mjs",
    "test:sgs-web": "node apps/scripts/test-sgs-web.mjs",
    "sgs:history": "node apps/scripts/sgs-history.mjs"
  }
}
