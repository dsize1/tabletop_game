{
  "name": "tabletop-game",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "仓库根脚本入口（真正的 npm workspaces 根在 apps/）。仅做命令转发，勿在此安装依赖。",
  "scripts": {
    "dev:up": "node apps/scripts/dev-up.mjs",
    "dev:up:qq": "node apps/scripts/dev-up.mjs",
    "dev:up:noqq": "node apps/scripts/dev-up.mjs --no-qq",
    "dev:down": "node apps/scripts/dev-down.mjs",
    "status": "node apps/scripts/status.mjs",
    "check:decision": "node apps/scripts/check-decision-service.mjs",
    "check:proactive-gate": "node apps/scripts/check-proactive-gate.mjs",
    "verify:push": "node apps/verify-push.mjs",
    "test:agent-gateway": "npm --prefix apps run test:agent-gateway",
    "test:qq-gateway": "npm --prefix apps run test:qq-gateway",
    "test:web": "npm --prefix apps run test:web",
    "assets:board": "node apps/scripts/board-assets.mjs",
    "deploy:local": "node apps/scripts/deploy-local.mjs",
    "dev:props": "npm --prefix apps run dev:props",
    "build:props": "npm --prefix apps run build:props",
    "test:props": "npm --prefix apps run test:props",
    "check:props-boundary": "node apps/scripts/check-props-admin-boundary.mjs",
    "gen:sgs-engine-data": "node apps/scripts/gen-sanguosha-engine-data.mjs",
    "check:sgs-engine-data": "node apps/scripts/gen-sanguosha-engine-data.mjs --check",
    "check:sgs-skill-cases": "node apps/scripts/check-sgs-skill-cases.mjs",
    "check:sgs-general-names": "node apps/scripts/check-sgs-general-names.mjs",
    "check:sgs-skill-docs": "node apps/scripts/check-sgs-skill-docs.mjs",
    "check:sgs-counts": "node apps/scripts/check-sgs-counts.mjs",
    "check:sgs-align": "node apps/scripts/check-sgs-align.mjs",
    "sgs:align": "node apps/scripts/sgs-align-sheet.mjs",
    "check:sgs2": "cargo test --manifest-path crates/Cargo.toml -p sanguosha2",
    "check:sgs2:metrics": "node apps/scripts/check-sgs2-metrics.mjs",
    "check:sgs-retire": "node apps/scripts/check-sgs-retire.mjs",
    "gen:sgs-skill-text": "node apps/scripts/gen-sgs-skill-text.mjs",
    "check:sgs-skill-text": "node apps/scripts/gen-sgs-skill-text.mjs --check",
    "check:sgs-pack-presets": "node apps/scripts/check-sgs-pack-presets.mjs",
    "check:sgs-pack-pool": "cargo test --manifest-path crates/Cargo.toml -p sanguosha pack_pool",
    "check:sgs-ai": "node apps/scripts/check-sgs-ai.mjs",
    "check:sgs-ai:100": "node apps/scripts/check-sgs-ai.mjs --games 100",
    "check:sgs-ai:standard": "node apps/scripts/check-sgs-ai.mjs --generals standard",
    "check:sgs-ai:full": "node apps/scripts/check-sgs-ai.mjs --games 100 --generals full",
    "check:sgs-view-contract": "cargo test --manifest-path crates/Cargo.toml -p sanguosha view_contract",
    "check:interaction-primitives": "cargo test --manifest-path crates/Cargo.toml -p sanguosha interaction_",
    "sgs:batch-status": "node apps/scripts/sgs-batch-status.mjs",
    "check:sgs-generals": "node apps/scripts/sgs-general-audit.mjs --check-matrix && node apps/scripts/sgs-general-audit.mjs --check --sample 8",
    "check:sgs-generals:matrix": "node apps/scripts/sgs-general-audit.mjs --check-matrix",
    "audit:sgs-generals": "node apps/scripts/sgs-general-audit.mjs --batch",
    "audit:sgs-generals:all": "node apps/scripts/sgs-general-audit.mjs --all --repeat 1",
    "audit:sgs-generals:no-scene": "node apps/scripts/sgs-general-audit.mjs --no-scene --batch",
    "sheet:sgs-audit": "node apps/scripts/sgs-audit-sheet.mjs --batch",
    "gen:sgs-audit-scenes": "node apps/scripts/sgs-general-audit.mjs --all --scenes-only",
    "check:sgs-batch-consistency": "node apps/scripts/check-sgs-batch-consistency.mjs",
    "audit:sgs-generals:list": "node apps/scripts/sgs-general-audit.mjs --list",
    "gen:sgs-audit-matrix": "node apps/scripts/sgs-general-audit.mjs --matrix",
    "sgs:batch-scaffold": "node apps/scripts/sgs-batch-scaffold.mjs",
    "sgs:check": "node apps/scripts/check-sgs-all.mjs",
    "sgs:check:fast": "node apps/scripts/check-sgs-all.mjs --fast",
    "sgs:check:full": "node apps/scripts/check-sgs-all.mjs --full",
    "verify:sanguosha": "node apps/verify-sanguosha.mjs",
    "sgs:web-room": "node apps/scripts/sgs-web-room.mjs",
    "test:sgs-web": "node apps/scripts/test-sgs-web.mjs",
    "test:sgs-web:fx": "node apps/scripts/test-sgs-web.mjs --fx",
    "test:sgs-bot": "node apps/scripts/test-sgs-bot-web.mjs",
    "sgs:history": "node apps/scripts/sgs-history.mjs",
    "test:web-login": "node apps/scripts/test-web-login.mjs",
    "check:union-openid": "node apps/scripts/check-union-openid.mjs",
    "dev:web-login": "node apps/scripts/dev-web-login.mjs",
    "props:login": "node apps/scripts/dev-web-login.mjs --scope props",
    "sgs:export-decisions": "node apps/scripts/sgs-export-decisions.mjs",
    "sgs:replay": "cargo run --manifest-path crates/Cargo.toml -p server --bin sgs-replay --",
    "check:sgs-decision-log": "node apps/scripts/check-sgs-decision-log.mjs",
    "check:sgs-preview": "node apps/scripts/check-sgs-preview.mjs",
    "check:sgs-preview:ui": "node apps/scripts/check-sgs-preview.mjs --ui",
    "check:sgs-assets": "node apps/scripts/check-sgs-assets.mjs",
    "gen:fx": "node apps/scripts/gen-fx-assets.mjs",
    "check:fx-assets": "node apps/scripts/check-fx-assets.mjs",
    "sgs2:scenes": "node apps/scripts/sgs2-scenes.mjs",
    "check:sgs2:scenes": "node apps/scripts/sgs2-scenes.mjs --check"
  }
}
